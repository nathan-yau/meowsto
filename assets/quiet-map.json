{
  "version": 8,
  "name": "Meowsto — cozy sage map",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet/latest",
      "attribution": "<a href=\"https://openfreemap.org/\">OpenFreeMap</a> · © <a href=\"https://openmaptiles.org/\">OpenMapTiles</a> · © <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a>"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#ebf4e9" }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", "class", "wood", "grass", "scrub"],
      "paint": { "fill-color": "#d9e6cf", "fill-opacity": 0.85 }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", "class", "residential"],
      "paint": { "fill-color": "#f3ecde", "fill-opacity": 0.55 }
    },
    {
      "id": "landuse-garden",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["in", "class", "park", "recreation_ground", "village_green", "garden", "cemetery", "pitch"],
      "paint": { "fill-color": "#d6e5c3", "fill-opacity": 0.9 }
    },
    {
      "id": "parks",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": { "fill-color": "#dce7cb", "fill-opacity": 0.85 }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": { "fill-color": "#b8dfe3" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#a9d4da",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.8, 16, 4]
      },
      "layout": { "line-cap": "round", "line-join": "round" }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-color": "#e8dfd0",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 14, 0.35, 16, 0.7],
        "fill-outline-color": "#d8d2c2"
      }
    },
    {
      "id": "road-path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "path", "track", "footway", "cycleway"],
      "minzoom": 14,
      "paint": {
        "line-color": "#c9bfae",
        "line-width": ["interpolate", ["linear"], ["zoom"], 14, 0.6, 18, 2],
        "line-dasharray": [2, 1.5]
      }
    },
    {
      "id": "road-local-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "street", "street_limited"],
      "minzoom": 12,
      "paint": {
        "line-color": "#e2d7c2",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1.2, 16, 6, 19, 16]
      },
      "layout": { "line-cap": "round", "line-join": "round" }
    },
    {
      "id": "road-local",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "street", "street_limited"],
      "minzoom": 12,
      "paint": {
        "line-color": "#fffaf0",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.8, 16, 4.5, 19, 13]
      },
      "layout": { "line-cap": "round", "line-join": "round" }
    },
    {
      "id": "road-main-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "primary", "secondary", "tertiary", "trunk"],
      "paint": {
        "line-color": "#e2d7c2",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1.2, 12, 4, 16, 11, 19, 26]
      },
      "layout": { "line-cap": "round", "line-join": "round" }
    },
    {
      "id": "road-main",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "primary", "secondary", "tertiary", "trunk"],
      "paint": {
        "line-color": "#fffaf0",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.7, 12, 2.5, 16, 8, 19, 22]
      },
      "layout": { "line-cap": "round", "line-join": "round" }
    },
    {
      "id": "road-motorway-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "motorway"],
      "paint": {
        "line-color": "#f0c4b8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1.5, 12, 5, 16, 14, 19, 28]
      },
      "layout": { "line-cap": "round", "line-join": "round" }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "motorway"],
      "paint": {
        "line-color": "#ffcec0",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1, 12, 3.5, 16, 10, 19, 24]
      },
      "layout": { "line-cap": "round", "line-join": "round" }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["all", ["==", "admin_level", 2], ["!=", "maritime", 1]],
      "paint": {
        "line-color": "#b9cfae",
        "line-width": ["interpolate", ["linear"], ["zoom"], 2, 0.6, 8, 1.4],
        "line-dasharray": [4, 2],
        "line-opacity": 0.7
      }
    },
    {
      "id": "water-name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "minzoom": 6,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Italic"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 11, 12, 14],
        "text-max-width": 8,
        "symbol-placement": "point"
      },
      "paint": {
        "text-color": "#5a8a90",
        "text-halo-color": "#faf7ee",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "place-village",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", "class", "village", "hamlet", "suburb", "neighbourhood"],
      "minzoom": 10,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 11, 14, 13],
        "text-max-width": 8,
        "text-transform": "none",
        "text-padding": 2
      },
      "paint": {
        "text-color": "#6b5748",
        "text-halo-color": "#faf7ee",
        "text-halo-width": 1.6,
        "text-halo-blur": 0.4
      }
    },
    {
      "id": "place-town",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", "class", "town"],
      "minzoom": 7,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 7, 12, 12, 16],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#5c4a3d",
        "text-halo-color": "#faf7ee",
        "text-halo-width": 1.8,
        "text-halo-blur": 0.4
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", "class", "city"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 12, 10, 18, 14, 22],
        "text-max-width": 8,
        "text-transform": "none"
      },
      "paint": {
        "text-color": "#38271f",
        "text-halo-color": "#faf7ee",
        "text-halo-width": 2,
        "text-halo-blur": 0.5
      }
    },
    {
      "id": "place-state",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", "class", "state"],
      "maxzoom": 8,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 3, 11, 7, 14],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.08,
        "text-max-width": 10
      },
      "paint": {
        "text-color": "#81796e",
        "text-halo-color": "#faf7ee",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place-country",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", "class", "country"],
      "maxzoom": 6,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 2, 12, 5, 16],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.1,
        "text-max-width": 10
      },
      "paint": {
        "text-color": "#5b8a63",
        "text-halo-color": "#faf7ee",
        "text-halo-width": 1.8
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 10, 16, 13],
        "text-rotation-alignment": "map",
        "text-pitch-alignment": "viewport",
        "text-max-angle": 30,
        "text-padding": 2
      },
      "paint": {
        "text-color": "#6b5748",
        "text-halo-color": "#faf7ee",
        "text-halo-width": 1.5,
        "text-halo-blur": 0.3
      }
    },
    {
      "id": "poi-park-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "filter": ["in", "class", "park", "garden"],
      "minzoom": 14,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Italic"],
        "text-size": 11,
        "text-max-width": 8,
        "text-optional": true
      },
      "paint": {
        "text-color": "#588967",
        "text-halo-color": "#faf7ee",
        "text-halo-width": 1.4
      }
    }
  ]
}
